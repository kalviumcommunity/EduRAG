# Database
DATABASE_URL=postgresql://edurag_user:edurag_password@localhost:5432/edurag_db

# Security & Authentication
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services. Mock mode runs without paid model API calls.
LLM_PROVIDER=mock
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# To use NVIDIA Nemotron, set LLM_PROVIDER=nvidia and LLM_MODEL to:
# nvidia/nemotron-3.5-lightning-30b-a3b

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536

# For NVIDIA semantic search, set EMBEDDING_PROVIDER=nvidia and EMBEDDING_MODEL to:
# nvidia/nemotron-3-embed-1b

# RAG Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
